# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local

# Telegram session files (CRITICAL - contains auth tokens)
*.session
*.session-journal

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
cache/

# Logs
logs/
*.log

# Virtual environments
venv/
env/
.venv/

# Generated dashboard output - inlines live log data (balances, tx hashes, and
# whatever an error message happened to contain). Build artifact, not source.
dashboard.html
dashboard_artifact.html

# Local dual-repo tooling. Belongs to this checkout, not to either published
# repo -- it hardcodes local paths and is specific to the fork arrangement.
sync_public.py
push_both.bat

# Local audit includes private trading results.
AUDIT_REPORT.md
